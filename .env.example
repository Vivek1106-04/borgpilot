# AsterixDB cluster (local)
ASTERIX_URL=http://localhost:19002
ASTERIX_DATAVERSE=borg

# AsterixDB MCP gateway — path to the standalone server we spawn over stdio.
# Use absolute path. The server lives in a sibling repo (see README).
# Example: /Users/vivek/asterixdb-mcp-server/.venv/bin/asterixdb-mcp
ASTERIXDB_MCP_COMMAND=asterixdb-mcp

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Borg 2019 ingestion (public GCS mirror, no auth needed for downloads)
BORG_GCS_BUCKET=gs://clusterdata_2019_a
BORG_LOCAL_CACHE=./data/borg
BORG_CELL=a

# Agent runtime
BORGPILOT_MAX_TURNS=20
BORGPILOT_LOG_DIR=./agent_traces
